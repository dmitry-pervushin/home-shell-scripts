function ps1() {
	local param_color=$1
	local prompt_symbol="%"

	if [ "$EUID" -eq 0 ]; then
		prompt_symbol="#"
	fi

	echo -n "\[${COLOR_Reset}\]"
	if [ "$(is-git-controlled)" != "" ]; then
		echo -n "\[${COLOR_Green}\]git \[${COLOR_Reset}\]"
	fi
	#echo -n '\[$(is-git-shallowed)\] * \[${COLOR_Reset}\]'
	echo -n "\[${param_color}\]"
	echo -n '(\h:'
	split_pwd=($(pwd | sed "s:^${HOME}:/~:" | tr ' ' '\a' | tr '/' ' '))
	for pwd_item in ${split_pwd[*]}; do
		color="${param_color}"
                #
                # Oooh, welcome to regex horror
                #
                # it passes if the string (bnetween ^...$) is:
                #     V + character
                #     R + digits
                #     REL + digits
                #     REL- + digits
                #     NTG6 or NTG7
                #     MAIN, DEV-MAIN or MBITION
                #
		if printf '%s' "$pwd_item" | tr '[:lower:]' '[:upper:]' | command grep -qE '^(V.?|R[0-9]+|REL[0-9]+|REL-.*|NTG[6-7]|MAIN|DEV-MAIN|MBITION)$'; then
			color="${COLOR_Cyan}"
		fi
		echo -n "\[${color}\]"
		if [ ${pwd_item} != "~" ]; then
			echo -n "/"
		fi
		echo -n "${pwd_item}" | tr '\a' ' '
	done
	echo -n ")\[${COLOR_Reset}\] "
	echo -n "${prompt_symbol} \[${COLOR_Reset}\]"
}

