function shell-scripts-check() {
	local required_commands="sh bash git cp chmod mkdir touch ln dirname basename pwd hostname grep sed tr date cmp readlink"
	local optional_commands="tput make ssh scp rsync python3 vim"
	local cmd path
	local missing=0

	echo "# Required commands"
	for cmd in $required_commands; do
		if path=$(command -v "$cmd" 2>/dev/null); then
			printf 'ok      %-10s %s\n' "$cmd" "$path"
		else
			printf 'missing %-10s\n' "$cmd"
			missing=1
		fi
	done

	echo "# Optional commands used by common helpers"
	for cmd in $optional_commands; do
		if path=$(command -v "$cmd" 2>/dev/null); then
			printf 'ok      %-10s %s\n' "$cmd" "$path"
		else
			printf 'optional %-9s not found\n' "$cmd"
		fi
	done

	return "$missing"
}

function _shell_scripts_repo() {
	if [ -n "${SHELL_SCRIPTS_REPO:-}" ]; then
		printf '%s\n' "$SHELL_SCRIPTS_REPO"
