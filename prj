function do_copy_using1() {
	local copy_command="$1"
	local source="$TARGET_O/$2"
	local destination="$TARGET_TFTP/$3"
	local FS
	FS=$(_filesize "$source")
	[ "$PRJ_SILENT" -eq 0 ] && echo "# ($source) =>"
	[ "$PRJ_SILENT" -eq 0 ] && echo "# => ($TARGET_TFTP) $3 size $FS"
	"$copy_command" "$source" "$destination"
}

function do_copy_using() {
	local CP_CMD
	if [ $# -ge 1 ]; then
		CP_CMD="$1"
		shift
	fi

	if [ $# -ge 2 ]; then
		while [ $# -ge 2 ]; do
			do_copy_using1 "$CP_CMD" "$1" "$2"
			shift
			shift
		done
	else
		do_copy_using1 "$CP_CMD" "$TARGET_PATH/$TARGET_TARGET" "$TARGET_TARGET_BIN"
	fi
}

