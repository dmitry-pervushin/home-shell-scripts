function parent-has() {
	local PWD_SOURCE="$(pwd)"
	pushd "${PWD_SOURCE}" > /dev/null
	while [ "$(pwd)" != "/" ]; do
		for candidate in "$@"; do
			if [ ! -e $candidate ]; then
				cd ..
				continue 2 # continue the outer loop
			fi
		done
		break
	done
	if [ $# -ge 2 ]; then
		if [ "$2" != "" ]; then
			cd $2
		fi
	fi
	echo -ne $(pwd)
	popd >/dev/null
}

function is-under() {
	local PWD_SOURCE="$(pwd)"
	local R=0
	pushd "${PWD_SOURCE}" >/dev/null

	pushd $1 >/dev/null;
        if [ $? -ne 0 ]; then
		popd > /dev/null
		echo -ne 0
		return
	fi

        local P1=$(/bin/pwd); popd > /dev/null
	pushd $2 >/dev/null
	while true; do
		local P=$(/bin/pwd)
		if [ "$P" == "/" ]; then
			break
		fi
		if [ "$P" == "$P1" ]; then
			R=1
			break
		fi
		cd ..
	done
	popd >/dev/null
	popd >/dev/null
	echo -ne $R
}

function is-git-controlled() {
	local gitroot=$(parent-has ".git")
	if [ ${gitroot} == "/"  ]; then
		echo ''
		return
	fi
	echo "${gitroot}/.git"
}

function is-git-shallowed() {
	gitroot=$(is-git-controlled)
	if [ -z ${gitroot} ]; then
		echo -n "${COLOR_Black}"
		return
	fi
	echo -n "${COLOR_Green}"
}


