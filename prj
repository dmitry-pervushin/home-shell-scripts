function nv() {
	#
	# currently accepted options: s, r,d, q,f,l, 1 and -
	#
	local SAFETY=none
	local RELEASE=release
	local TYPE=idk
	local CHIP="generic"
	local KVARIANT="/bin/true"
	local arg unknown length char i

	if [ "$#" -eq 0 ]; then
		echo "Usage: nv OPTIONS -- COMMAND [ARG ...]" >&2
		return 2
	fi

	while [ "$#" -gt 0 ]; do
		arg="$1"
		unknown=0
		length=${#arg}
		for ((i = 0; i < length; i++)); do
			char="${arg:i:1}"
			case "${char}" in
			s) SAFETY="safety";;
			r) RELEASE="release";;
			d) RELEASE="debug";;
			q) TYPE="qnx";;
			f) TYPE="foundation";;
			l) TYPE="linux";;
			1) CHIP="t186ref";;
			8) CHIP="t186ref";;
			-) unknown=1;shift;break;;
			*) unknown=1;break;;
			esac
		done
		if [ ${unknown} -ne 0 ]; then
			break
		fi
		shift
	done
	construction="embedded-${TYPE} ${CHIP} ${SAFETY} ${RELEASE} external"
	if [ ${TYPE} == "linux" ]; then construction="${construction} aarch64"; fi
	# say "Construction = '${construction}'\n"
	nv-do "${construction}" "${KVARIANT}" "$@"
}

