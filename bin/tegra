#!/bin/bash

set -euo pipefail

with ()
{
    python /opt/shoelace/with.py $*
}

main()
{
    init_defaults
    read_user_config

    if [[ $# -eq 0 || ( $1 = pretend && $# -eq 1 ) ]]; then
        print_error "Missing arguments"
        echo
        print_help_hint
        exit 1
    fi

    PRETEND=""
    if [[ $1 = pretend ]]; then
        PRETEND=1
        shift
    fi

    local COMMAND="$1"
    shift
    case "$COMMAND" in
        help|-h|-help|--help)
            print_usage
            ;;

        status)
            print_status
            ;;

        set)
            set_options "$@"
            ;;

        branch)
            do_branch "$@"
            ;;

        sync)
            do_sync "$@"
            ;;

        build)
            do_build "$@"
            ;;

        fetch)
            do_fetch "$@"
            ;;

        flash)
            do_flash "$@"
            ;;

        reboot)
            do_reboot "$@"
            ;;

        mods)
            do_mods "$@"
            ;;

        gdbserver)
            do_gdbserver "$@"
            ;;

        gdbclient)
            do_gdbclient "$@"
            ;;

        buildgdb)
            do_buildgdb "$@"
            ;;

        shell)
            do_shell "$@"
            ;;

        *)
            print_error "Unrecognized command - $COMMAND"
            echo
            print_help_hint
            exit 1
    esac
}

print_help_hint()
{
    echo "Run \`tegra help' for help"
}

print_error()
{
    echo "Error: $@" >&2
}

die()
{
    print_error "$@"
    exit 1
}

print_usage()
{
    echo "Versatile Tegra helper, which lets you build MODS, run MODS and more"
    echo
    echo "Usage: tegra [pretend] <COMMAND>..."
    echo
    echo "Commands:"
    echo "    status                        Print properties and status"
    echo "    set <NAME> <VALUE>            Set a property NAME to VALUE"
    echo "    branch <BRANCH>               Set tree to a specific branch"
    echo "    sync                          Sync tree"
    echo "    build [linux] [mods] [clean]  Build Linux and/or MODS"
    echo "    build p4 [mods] [clean]       Build MODS from Perforce/chips_a"
    echo "    fetch <VRL_NAME>              Fetch Linux image from PVS"
    echo "    flash                         Flash Linux on the target"
    echo "    reboot                        Reboot the target"
    echo "    mods [ARGS...]                Run MODS on the target"
    echo "    gdbserver [ARGS...]           Run MODS on the target with gdbserver"
    echo "    gdbclient [GDB_CMDS...]       Run gdb client locally to connect to gdbserver"
    echo "    buildgdb                      Compile client gdb for aarch64"
    echo "    shell <COMMAND> [ARGS...]     Run an arbitrary command on the target"
    # TODO more commands
    echo
}

_TEGRA_OPTIONS=(
    "TOP"       "tree"     ""
    "DEBUG"     "debug"    "off"
    "DEV"       "dev"      "on"
    "CONN"      "conn"     "adb"
    "TARGET"    "target"   ""
    "GDB"       "gdb"      ""
    "RUNSPACE"  "runspace" ""
    "OUTPUT"    "output"   ""
    "ADBSERIAL" ""         ""
    )

init_defaults()
{
    local I=0
    while [[ $I -lt ${#_TEGRA_OPTIONS[*]} ]]; do
        local VAR="_TEGRA_${_TEGRA_OPTIONS[$I]}"
        local DEFAULT="${_TEGRA_OPTIONS[$(($I+2))]}"
        eval "$VAR='$DEFAULT'"
        I=$(($I+3))
    done
}

write_user_config()
{
    [[ -f ~/.tegra ]] && mv ~/.tegra ~/.tegra.bak
    echo -n "" > ~/.tegra
    local I=0
    while [[ $I -lt ${#_TEGRA_OPTIONS[*]} ]]; do
        local VAR="_TEGRA_${_TEGRA_OPTIONS[$I]}"
        local DEFAULT="${_TEGRA_OPTIONS[$(($I+2))]}"
        if [[ ${!VAR} != $DEFAULT ]]; then
            echo "$VAR=\"${!VAR}\"" >> ~/.tegra
        fi
        I=$(($I+3))
    done
}

read_user_config()
{
    [[ ! -f ~/.tegra ]] || source ~/.tegra
}

get_current_branch()
{
    [[ ${_TEGRA_TOP:-} ]] || return 0
    local CONFIG="$_TEGRA_TOP/.repo/manifests.git/config"
    [[ -f $CONFIG ]] || return 0
    local BRANCH=$(sed -ne 's:^[ \t]*merge = refs/heads/::p' "$CONFIG")
    echo "$BRANCH"
}

get_current_branch_status()
{
    local BRANCH=$(get_current_branch)
    [[ -z $BRANCH ]] || BRANCH=" ($BRANCH)"
    echo "$BRANCH"
}

get_adb()
{
    local ADB="$_TEGRA_TOP"/tinylinux/adb/adb
    if [ -x "$ADB" ]; then
        echo "$ADB"
    else
        which adb 2>/dev/null
    fi
}

set_adb_serial()
{
    local DESIRED_ADBSERIAL=$(get_adb_serial)
    [[ $DESIRED_ADBSERIAL = ${ANDROID_SERIAL:-} ]] || runcmd export ANDROID_SERIAL=$DESIRED_ADBSERIAL
}

list_adb_devices()
{
    local ADB=$(get_adb)
    if [[ -n $ADB ]]; then
        "$ADB" devices 2>&1 | grep "\<device\>" || true
    fi
}

get_adb_serial()
{
    if [[ ${_CACHED_ADBSERIAL:-no serial} = "no serial" ]]; then
        _CACHED_ADBSERIAL=""
        if [[ -n ${ANDROID_SERIAL:-} ]]; then
            _CACHED_ADBSERIAL="$ANDROID_SERIAL"
        elif [[ -n $_TEGRA_ADBSERIAL ]]; then
            _CACHED_ADBSERIAL="$_TEGRA_ADBSERIAL"
        else
            local ADB=$(get_adb)
            if [[ -n $ADB ]]; then
                local DEVICES=( $(list_adb_devices) )
                if [[ ${#DEVICES[*]} -eq 2 ]]; then
                    _CACHED_ADBSERIAL=${DEVICES[0]}
                fi
            fi
        fi
    fi

    echo "$_CACHED_ADBSERIAL"
}

get_printable_adb_serial()
{
    local ADBSERIAL=$(get_adb_serial)
    echo "${ADBSERIAL:-\$ANDROID_SERIAL not set}"
}

have_uart_access()
{
    test -r "$1" && test -w "$1" && return 0
    return 1
}

get_printable_console_uart()
{
    if [[ $(find_ports 2 | wc -l) = 0 ]]; then
        echo ""
    else
        get_target_uart
    fi
}

get_conn_status()
{
    if [[ $_TEGRA_CONN = adb ]]; then
        local ADB="$(get_adb)"
        if [[ $ADB ]]; then
            echo " ($(get_printable_adb_serial), ${ADB})"
        else
            echo " (adb executable not found)"
        fi
    elif [[ $_TEGRA_CONN = uart ]]; then
        local UART="$(get_printable_console_uart)"
        if [[ -z $UART ]]; then
            echo " (no UART port detected)"
        elif have_uart_access "$UART"; then
            echo " ($UART)"
        else
            echo " (access denied to $UART)"
        fi
    fi
}

get_printable_flash_target()
{
    local UART=""
    [[ $_TEGRA_CONN = uart ]] || UART="$(get_printable_console_uart)"
    if [[ -z ${_TEGRA_TARGET:-} || ${_TEGRA_TARGET:-} = $(get_flash_target) ]]; then
        [[ -z $UART ]] || echo " (UART on $UART)"
    elif [[ -z $UART ]]; then
        echo " ($(get_flash_target))"
    else
        echo " ($(get_flash_target), UART on $UART)"
    fi
}

get_gdb_dir()
{
    echo "${_TEGRA_GDB:-${_TEGRA_TOP:-.}/gdb}"
}

get_gdb()
{
    local GDB_DIR="$(get_gdb_dir)"
    local EXE="$GDB_DIR/bin/aarch64-unknown-linux-gnu-gdb"
    [[ ! -d "$GDB_DIR/bin" ]] || ! test -x "$EXE" || echo "$EXE"
}

get_gdb_status()
{
    local GDB="$(get_gdb)"
    [[ $GDB ]] || echo " (missing)"
}

check_python()
{
    local PYTHON=$(python --version 2>&1 || true)
    [[ $PYTHON =~ ^Python\ 2\.7 ]] || die "Incorrect Python version ${PYTHON##Python }, need Python 2.7"
}

check_flash_target()
{
    if [[ -z ${_TEGRA_TARGET:-} ]]; then
        print_error "Target is not set"
        echo >&2
        echo "Use \`tegra set target xxx' to set target" >&2
        exit 1
    fi
}

get_flash_target()
{
    if [[ -z ${_TEGRA_TARGET:-} ]]; then
        echo "Error: Flash target not set!" >&2
        exit 1
    fi

    if [[ ${_TEGRA_FLASH_TARGET:-} ]]; then
        echo "$_TEGRA_FLASH_TARGET"
        return 0
    fi

    if [[ -f /etc/tegraboards ]]; then
        local LINE
        while read LINE; do
            local NAME="$(echo "$LINE" | cut -f 1 -d ' ')"
            local TARGET="$(echo "$LINE" | cut -f 2- -d ' ')"
            if [[ $_TEGRA_TARGET = $NAME ]]; then
                _TEGRA_FLASH_TARGET="$TARGET"
                echo "$TARGET"
                return 0
            fi
        done < /etc/tegraboards
    fi

    _TEGRA_FLASH_TARGET="$_TEGRA_TARGET"
    echo "$_TEGRA_TARGET"
}

get_build_target()
{
    local FLASH_TARGET="$(get_flash_target)"
    if [[ $FLASH_TARGET =~ 2220 || $FLASH_TARGET =~ 3350 || $FLASH_TARGET =~ 2371 || $FLASH_TARGET =~ 2897 ]]; then
        echo "t210ref"
        return 0
    fi

    echo "t186ref"
}

get_nv_outdir_rel()
{
    local BUILD_TYPE="release"
    [[ $_TEGRA_DEBUG = on ]] && BUILD_TYPE="debug"
    echo "out/mods-$(get_build_target)-$BUILD_TYPE-aarch64"
}

get_nv_outdir()
{
    echo "$_TEGRA_TOP/$(get_nv_outdir_rel)"
}

get_mods_runspace()
{
    echo "${_TEGRA_RUNSPACE:-"$(get_nv_outdir)"/nvidia/mods/runspace}"
}

runcmd()
{
    if [[ $PRETEND ]]; then
        echo "%" "$@"
        if [[ $1 = export ]] || [[ $1 = cd && -d $2 ]]; then
            "$@" || true
        fi
        return 0
    fi

    if ! "$@"; then
        local EC=$?
        echo "Failed command:" "$@"
        exit $EC
    fi
}

silentruncmd()
{
    if [[ $PRETEND ]]; then
        echo "%" "$@"
        return 0
    fi

    "$@" > /dev/null 2>&1 || true
}

rm_all()
{
    if [[ $PRETEND ]]; then
        echo "% rm -rf $1/*"
    else
        rm -rf "$1"/*
    fi
}

cp_all()
{
    if [[ $PRETEND ]]; then
        echo "% cp -a $1/* $2/"
    else
        cp -a "$1"/* "$2"/
    fi
}

run_pm342()
{
    local PM342="$(which pm342 2>/dev/null || true)"
    [[ -n $PM342 ]] || die "pm342 tool not found in PATH"
    test -x "$PM342" || die "Found $PM342, but it is not executable"
    if [[ ${_TEGRA_TARGET:-} != $(get_flash_target) ]]; then
        if [[ ${PM342_SERIAL:-} != $_TEGRA_TARGET ]]; then
            runcmd export PM342_SERIAL="$_TEGRA_TARGET"
        fi
    fi
    runcmd pm342 "$1"
}

board_ctl()
{
    [[ $# -eq 1 ]] || die "Internal error: invalid args to board_ctl"

    local COMMAND="$1"

    case "$(get_flash_target)" in

        quill)
            case "$COMMAND" in
                recovery)
		    run_pm342 onkey_down
		    runcmd sleep 15
		    run_pm342 onkey_up
                    runcmd sleep 1
		    run_pm342 onkey
		    run_pm342 reset_recovery
                    ;;
                reboot)
		    run_pm342 onkey_down
		    runcmd sleep 15
		    run_pm342 onkey_up
                    run_pm342 onkey
                    ;;
                *)
                    die "Command $COMMAND not implemented for $(get_flash_target)"
            esac
            ;;

        xavier-slt*)
            case "$COMMAND" in
                recovery)
		    run_pm342 force_off
		    runcmd sleep 1
		    run_pm342 recovery_down
		    run_pm342 onkey_down
		    runcmd sleep 1
		    run_pm342 onkey_up
		    run_pm342 recovery_up
                    ;;
                reboot)
                    run_pm342 force_off
                    run_pm342 onkey_down
                    runcmd sleep 1
                    run_pm342 onkey_up
                    ;;
                *)
                    die "Command $COMMAND not implemented for $(get_flash_target)"
            esac
            ;;

	ntg7)
	    with b9-c2 power off
	    with b9-c2 recovery on
            with b9-c2 power on
            ;;

        # Correctly designed boards support this sequence
        *)
            case "$COMMAND" in
                recovery)
		    run_pm342 force_off
		    runcmd sleep 2
		    run_pm342 recovery_down
		    runcmd sleep 1
		    run_pm342 onkey
		    run_pm342 recovery_up
                    ;;
                reboot)
		    run_pm342 force_off
		    runcmd sleep 2
                    run_pm342 onkey
                    ;;
                *)
                    die "Command $COMMAND not implemented for $(get_flash_target)"
            esac
            ;;

    esac

    #run_pm342 status
}

get_target_mods_path()
{
    # TODO
    echo "/data"
}

get_logs_dir()
{
    echo "${_TEGRA_OUTPUT:=${_TEGRA_TOP:-.}/logs}"
}

get_target_logs_dir()
{
    echo "/data/output"
}

escape_spaces()
{
    sed 's/ /\\ /g'
}

find_ports()
{
    ls -d /sys/bus/usb/devices/*/ttyUSB* 2>/dev/null | grep "1\.$1/" | sed "s/\/.*\//\/dev\//"
}

get_udev_field()
{
    local UDEV_PATH="$1"
    local FIELD="$2"
    udevadm info -a -p "$UDEV_PATH" \
        | grep "ATTRS{$FIELD}" \
        | head -n 1 \
        | sed -n 's/^ *ATTRS{'$FIELD'}=="\(.*\)"/\1/p'
}

find_serial()
{
    local USB="$1"
    local UDEV_PATH=$(udevadm info -q path -n "$USB")
    local SERIAL=$(udevadm info -a -p "$UDEV_PATH" \
                   | grep "ATTRS{idProduct}\|ATTRS{serial}" \
                   | grep -A 1 "idProduct.*6011" \
                   | sed -n 's/^ *ATTRS{serial}=="\(.*\)"/\1/p')
    # Not FTDI (6011) or not standalone PM342 board (e.g. DDPX)
    if [[ -z $SERIAL ]]; then
        local BUS=$(get_udev_field "$UDEV_PATH" "busnum")
        local DEV=$(get_udev_field "$UDEV_PATH" "devnum")
        SERIAL=$(printf "<%03d/%03d>" "$BUS" "$DEV")
    fi
    echo "$SERIAL"
    echo "$USB"
}

get_usb_port_num_from_flash_target()
{
    # A typical PM342 debug board exposes 4 UART ports as separate 4 ttyUSB
    # devices.  They are marked as 1.0 through 1.3, with the second digit
    # being what we call a "USB port number".
    #
    # For most Tegra boards so far, the UART with the kernel output is on
    # port 1.2, so we default to that.  However, on T194 BPMP and kernel
    # output is unified and go both to port 1.3.
    #
    # *IMPORTANT* When making updates to this function, please also update
    #             an identical function in //sw/mods/scripts/lstegra script.
    #             We don't source a common script to be able to copy lstegra
    #             script freely without dependencies.

    local PORT=2
    [[ $1 =~ xavier* ]] && PORT=3
    echo "$PORT"
}

get_target_uart()
{
    local FLASH_TARGET=""
    [[ -z ${_TEGRA_TARGET:-} ]] || FLASH_TARGET=$(get_flash_target)
    local PORT=$(get_usb_port_num_from_flash_target "$FLASH_TARGET")

    if [[ ${_TEGRA_TARGET:-} != $FLASH_TARGET ]]; then
        local PM342_TARGET=${PM342_SERIAL:-${_TEGRA_TARGET:-}}
        if [[ -n $PM342_TARGET ]]; then
            local USB
            for USB in $(find_ports "$PORT"); do
                USB=( $(find_serial "$USB") )
                if [[ ${USB[0]} = $PM342_TARGET ]]; then
                    echo "${USB[1]}"
                    return 0
                fi
            done
        fi
    fi

    find_ports "$PORT" | head -n 1
}

send_uart()
{
    local ARGS=( "$@" )

    local I=0
    while [[ $I -lt ${#ARGS[*]} ]]; do
        ARGS[$I]="$(echo "${ARGS[$I]}" | escape_spaces)"
        I=$(($I + 1))
    done

    if [[ $PRETEND ]]; then
        echo "% echo -e ${ARGS[@]} | tr '\\n' '\\r' >&3"
    else
        echo -e "${ARGS[@]}" | tr '\n' '\r' >&3
    fi
}

run_on_target()
{
    case "$_TEGRA_CONN" in
        uart) run_over_uart "$@" ;;
        adb)  run_over_adb "$@" ;;
        *)    die "Unrecognized connection method '$_TEGRA_CONN' in conn property" ;;
    esac
}

run_over_uart()
{
    local LOGSDIR="$(get_target_logs_dir)"
    local UART="$(get_target_uart)"

    if ! have_uart_access "$UART"; then
        ls -l "$UART"
        id
        die "Access to $UART denied, check device permissions or your groups"
    fi

    runcmd mkdir -p "$(get_logs_dir)"
    runcmd stty -F "$UART" 115200 cs8 cread clocal -icrnl -opost onlcr -icanon -echo
    if [[ $PRETEND ]]; then
        echo "% exec 3<>$UART"
        echo "% nohup cat <&3 | tee $(get_logs_dir)/output.log &"
    else
        exec 3<>"$UART"
        cat <&3 | tee "$(get_logs_dir)/output.log" &
    fi
    runcmd sleep 1

    # Background any process that may be running (e.g. editoror MODS),
    # then kill it
    send_uart "$(echo -en "\032")"
    send_uart kill %1

    # Prepare directory where we'll be running
    send_uart cd "$LOGSDIR"
    send_uart pwd

    # Run the requested command on the target
    send_uart "$@"

    # Capture exit code
    send_uart "EC=\$?"
    send_uart echo "Exit code: \$EC"
    send_uart echo "Exit code: \$EC"
    send_uart echo "Exit code: \$EC"
    send_uart echo "Exit code: \$EC"
    send_uart echo "Exit code: \$EC"

    # Wait for the target to finish
    if [[ -z $PRETEND ]]; then
        while ! tr -d '\r' < "$(get_logs_dir)/output.log" | grep -q "^Exit code: [0-9]\+$"; do
            sleep 1
        done
    fi

    if [[ $PRETEND ]]; then
        echo "% exec 3<&-"
    else
        # Close terminal
        exec 3<&-

        # Retrieve the exit code from target
        local EC="$(tr -d '\r' < "$(get_logs_dir)/output.log" | grep "^Exit code: [0-9]\+$" | head -n 1)"
        EC="${EC#Exit code: }"
        echo "$EC" > "$(get_logs_dir)/exitcode"
        if [[ $EC != 0 ]]; then
            echo "Exit code: $EC"
            exit "$EC"
        fi
    fi
}

run_over_adb()
{
    set_adb_serial
    local LOGSDIR="$(get_target_logs_dir)"
    local RUNSCRIPT="$LOGSDIR/run"
    local ADB=$(get_adb)
    local FILE="$("$ADB" shell "ls '$RUNSCRIPT'" 2>&1 || true)"
    if [[ $FILE != $RUNSCRIPT ]]; then
        runcmd "$ADB" shell "mkdir -p '$LOGSDIR'"
        mkdir -p "$(get_logs_dir)"
        sed 's/^ *//' >"$(get_logs_dir)/run" <<EOF
            #!/bin/bash

            cd "$LOGSDIR"
            rm -f mods.log exitcode
            "\$@" || echo "\$?" > "$LOGSDIR/exitcode"
EOF
        runcmd "$ADB" push "$(get_logs_dir)/run" "$RUNSCRIPT"
        runcmd "$ADB" shell "chmod 755 '$RUNSCRIPT'"
    fi
    runcmd "$ADB" shell "'$RUNSCRIPT' $@" | tee "$(get_logs_dir)/output.log"
    [ ! -e "$(get_logs_dir)/exitcode" ] || runcmd rm -rf "$(get_logs_dir)/exitcode"
    silentruncmd "$ADB" pull "$LOGSDIR/mods.log" "$(get_logs_dir)/mods.log"
    silentruncmd "$ADB" pull "$LOGSDIR/exitcode" "$(get_logs_dir)/exitcode"
    if [[ -f "$(get_logs_dir)/exitcode" ]]; then
        local EC="$(cat "$(get_logs_dir)/exitcode")"
        if [[ $EC != 0 ]]; then
            echo "Exit code: $EC"
            exit "$EC"
        fi
    fi
}

get_p4_branch()
{
    echo "sw/dev/gpu_drv/chips_a"
}

print_status()
{
    echo "Configuration:"
    echo "  tree:     ${_TEGRA_TOP:-.}$(get_current_branch_status)"
    echo "  debug:    $_TEGRA_DEBUG"
    echo "  dev:      $_TEGRA_DEV"
    echo "  conn:     $_TEGRA_CONN$(get_conn_status)"
    echo "  target:   ${_TEGRA_TARGET:-(not set)}$(get_printable_flash_target)"
    echo "  gdb:      $(get_gdb_dir)$(get_gdb_status)"
    echo "  runspace: ${_TEGRA_RUNSPACE:-(not set)}"
    echo "  output:   $(get_logs_dir)"
    echo "  \$P4ROOT:  ${P4ROOT:-(not set)}"

    # TODO print information about systems
}

set_options()
{
    if [[ $# -eq 0 ]]; then
        print_error "Missing options to set"
        echo
        print_help_hint
        exit 1
    fi

    while [[ $# -gt 1 ]]; do
        local NAME="$1"
        local VALUE="$2"
        shift 2

        local I=0
        local FOUND=""
        while [[ $I -lt ${#_TEGRA_OPTIONS[*]} ]]; do
            local VAR="_TEGRA_${_TEGRA_OPTIONS[$I]}"
            local CURNAME="${_TEGRA_OPTIONS[$(($I+1))]}"
            local DEFAULT="${_TEGRA_OPTIONS[$(($I+2))]}"
            if [[ -n $NAME && $CURNAME = $NAME ]]; then
                [[ $NAME = conn || $NAME = target ]] && _TEGRA_ADBSERIAL=""
                if [[ $DEFAULT = off || $DEFAULT = on ]]; then
                    [[ $VALUE != 0 ]] || VALUE="off"
                    [[ $VALUE != 1 ]] || VALUE="on"
                else
                    [[ -n $VALUE ]] || VALUE="$DEFAULT"
                fi
                eval "$VAR='$VALUE'"
                FOUND=1
                break
            fi
            I=$(($I+3))
        done

        if [[ -z $FOUND ]]; then
            print_error "Unrecognized option - $NAME"
            echo
            print_help_hint
            exit 1
        fi
    done

    [[ $# -eq 0 ]] || die "No value passed for option $1"

    write_user_config
}

do_branch()
{
    [[ $# -le 1 ]] || die "Unrecognized arguments: $@"
    [[ $# -eq 1 ]] || die "Missing branch"

    runcmd mkdir -p "$_TEGRA_TOP"
    runcmd cd "$_TEGRA_TOP"
    runcmd repo init -u ssh://git-master:12001/tegra/manifest.git --manifest-branch="$1" --manifest-name=mods-linux.xml
}

do_sync()
{
    [[ $# -eq 0 ]] || die "Unrecognized arguments: $@"

    runcmd cd "$_TEGRA_TOP"
    runcmd repo sync -cd --no-clone-bundle --no-tags -j 32
    runcmd repo status
}

do_build()
{
    local BUILD_LINUX=""
    local BUILD_MODS=""
    local BUILD_P4=0
    local CLEAN=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            linux) BUILD_LINUX=1 ;;
            mods)  BUILD_MODS=1  ;;
            p4)    BUILD_P4=1    ;;
            clean) CLEAN=1       ;;
            *)
                print_error "Unknown build option - $1"
                echo
                echo "Possible build options: linux mods p4"
                exit 1
        esac
        shift
    done

    if [[ $BUILD_P4 = 1 ]]; then
        [[ $BUILD_LINUX != 1 ]] || die "Cannot build Linux from git and MODS from Perforce at the same time"
        BUILD_LINUX=0
        BUILD_MODS=1
    fi

    if [[ $BUILD_MODS = 1 && -z $BUILD_LINUX ]]; then
        BUILD_LINUX=0
    elif [[ -z $BUILD_MODS && $BUILD_LINUX = 1 ]]; then
        BUILD_MODS=0
    elif [[ -z $BUILD_MODS && -z $BUILD_LINUX ]]; then
        BUILD_MODS=1
        BUILD_LINUX=1
    fi

    check_flash_target

    if [[ $BUILD_P4 = 1 ]]; then
        local BUILD_DIR="$P4ROOT/$(get_p4_branch)/diag/mods"
        [[ -d $BUILD_DIR ]] || die "Directory $BUILD_DIR not found"
        runcmd export MODS_RUNSPACE="$(get_mods_runspace)"
        runcmd cd "$BUILD_DIR"
        BUILD_TYPE="release"
        if [[ $_TEGRA_DEBUG = on ]]; then
            BUILD_TYPE="debug"
        elif [[ $_TEGRA_DEV = on ]]; then
            BUILD_TYPE="sanity"
        fi
        if [[ $CLEAN != 0 ]]; then
            local ARTIFACTS=${MODS_OUTPUT_DIR:-$(pwd)/artifacts}
            # Handle MODS_OUTPUT_DIR the same way hm handles it
            if [[ -d $ARTIFACTS/chips_a ]]; then
                ARTIFACTS="$ARTIFACTS/chips_a"
                runcmd export MODS_OUTPUT_DIR="$ARTIFACTS"
            fi
            runcmd rm -rf "$ARTIFACTS"
        fi
        rm_all "$MODS_RUNSPACE"
        echo "Building $BUILD_TYPE MODS from Perforce"
        echo "MODS source directory: $BUILD_DIR"
        echo "MODS_RUNSPACE: $MODS_RUNSPACE"
        runcmd make -j "$(grep -c ^proc /proc/cpuinfo)" BUILD_OS=tegra BUILD_OS_SUBTYPE=linux BUILD_CFG="$BUILD_TYPE" build_all
    else
        local GIT_MODS_RUNSPACE="$(get_nv_outdir)/nvidia/mods/runspace"
        local USER_MODS_RUNSPACE="$(get_mods_runspace)"

        runcmd cd "$_TEGRA_TOP"
        [[ $CLEAN = 0 ]] || runcmd rm -rf "$(get_nv_outdir_rel)"
        unset TOP
        unset TEGRA_TOP

        if [[ $BUILD_LINUX = 1 ]]; then
            local ARGS="$(get_build_target) internal"
            local SHOW_BUILD_LINUX="release"
            local SHOW_BUILD_MODS="release"
            if [[ $_TEGRA_DEBUG = on ]]; then
                ARGS="$ARGS debug"
                SHOW_BUILD_LINUX="debug"
                SHOW_BUILD_MODS="debug"
            elif [[ $_TEGRA_DEV = on ]]; then
                ARGS="$ARGS dev"
                SHOW_BUILD_MODS="dev"
            fi
            [[ $BUILD_MODS = 1 ]] && ARGS="$ARGS mods"

            [[ $BUILD_MODS = 1 ]] && echo "Building $SHOW_BUILD_MODS MODS"
            echo "Building $SHOW_BUILD_LINUX Linux"
            echo "Branch: $(get_current_branch)"
            echo "Target: $(get_build_target)"
            runcmd tinylinux/build.sh $ARGS
        else
            local ARGS=""
            local SHOW_BUILD_MODS="release"
            if [[ $_TEGRA_DEBUG = on ]]; then
                ARGS="debug"
                SHOW_BUILD_MODS="debug"
            elif [[ $_TEGRA_DEV = on ]]; then
                ARGS="dev"
                SHOW_BUILD_MODS="dev"
            fi

            echo "Building $SHOW_BUILD_MODS MODS from git"
            echo "Branch: $(get_current_branch)"
            echo "Target: $(get_build_target)"
            runcmd export NV_OUTDIR="$(get_nv_outdir)"
            runcmd tinylinux/build_mods.sh $ARGS
        fi

        if [[ $GIT_MODS_RUNSPACE != $USER_MODS_RUNSPACE ]]; then
            echo "Copying MODS to $USER_MODS_RUNSPACE"
            rm_all "$USER_MODS_RUNSPACE"
            cp_all "$GIT_MODS_RUNSPACE" "$USER_MODS_RUNSPACE"/
        fi
    fi
}

do_fetch()
{
    [[ $# -le 1 ]] || die "Unrecognized arguments: $@"
    [[ $# -eq 1 ]] || die "Missing PVS system name"
    [[ $1 =~ ^ausvrl ]] || die "$1 is not a name of a PVS system"

    check_python

    local BUILD_TARGET=$(get_build_target)
    local MIRROR_DIR="$P4ROOT/$(get_p4_branch)/drivers/unix/rmapi_tegra/mirror"
    [[ -d $MIRROR_DIR ]] || die "Directory $MIRROR_DIR not found"
    local IMAGE_SEL="$MIRROR_DIR/mods_${BUILD_TARGET%%ref}_linux_image"
    [[ -f $IMAGE_SEL ]] || die "File $IMAGE_SEL not found for target $BUILD_TARGET"
    local IMAGE_HTTP=$(cat "$IMAGE_SEL")
    local PVS_IMAGE_PATH="/data/images/${IMAGE_HTTP##http://}"
    local IMAGE_FILE=${PVS_IMAGE_PATH##*/}

    [[ ! -d "$(get_nv_outdir)/package" ]] || runcmd rm -rf "$(get_nv_outdir)/package"
    runcmd cd "$(get_nv_outdir)"

    local SIZE_MB=1024 # MODS partition size in MB

    echo "Fetching image..."
    runcmd sshpass -ppvs scp "pvs@$1:$PVS_IMAGE_PATH" "$IMAGE_FILE"
    echo "Unpacking..."
    runcmd tar xjf "$IMAGE_FILE"
    runcmd rm -f "$IMAGE_FILE"
    runcmd cd package
    echo "Resizing MODS partition..."
    runcmd ./add_mods.sh --empty --no-flash --size="$SIZE_MB"
}

do_flash()
{
    [[ $# -eq 0 ]] || die "Unrecognized arguments: $@"

    check_flash_target
    check_python

    if [[ -z $PRETEND && -n ${_TEGRA_ADBSERIAL:-} ]]; then
        _TEGRA_ADBSERIAL=""
        write_user_config
    fi

    echo "Putting the board in recovery mode..."
    board_ctl recovery

    echo "Flashing..."
    local DEVICES=( $(list_adb_devices) )
    runcmd cd "$(get_nv_outdir)/package"
    if [[ -f istemmc_testimg.dat ]]; then
        # Big istemmc partition is slow to flash, make it small
        runcmd rm -f istemmc_testimg.dat
        runcmd dd if=/dev/zero of=istemmc_testimg.dat bs=1M count=1
    fi
    runcmd ./flash.sh "$(get_flash_target)"

    echo "Waiting for boot..."
    if [[ -z $PRETEND ]]; then
        local SECONDS=60
        while true; do
            local NEW_DEVICES=( $(list_adb_devices) )
            [[ ${#NEW_DEVICES[*]} = ${#DEVICES[*]} ]] || break
            SECONDS=$(($SECONDS - 1))
            [[ $SECONDS -gt 0 ]] || break
            sleep 1
        done

        if [[ $SECONDS -eq 0 ]]; then
            echo "Failed to detect successful boot via adb"
        else
            local N=0
            while [[ $N -lt ${#NEW_DEVICES[*]} ]]; do
                local NEW_SERIAL=${NEW_DEVICES[$N]}

                local D=0
                while [[ $D -lt ${#DEVICES[*]} ]]; do
                    local OLD_SERIAL=${DEVICES[$D]}
                    [[ $NEW_DEVICES != $OLD_SERIAL ]] || break
                    D=$(($D + 2))
                done

                if [[ $D -ge ${#DEVICES[*]} ]]; then
                    echo "Auto-detected \$ANDROID_SERIAL=\"$NEW_SERIAL\""
                    _TEGRA_ADBSERIAL=$NEW_SERIAL
                    write_user_config
                    break
                fi

                N=$(($N + 2))
            done

            [[ $N -lt ${#NEW_DEVICES[@]} ]] || echo "Failed to auto-detect \$ANDROID_SERIAL"
        fi
    fi
}

do_reboot()
{
    [[ $# -eq 0 ]] || die "Unrecognized arguments: $@"
    check_flash_target
    board_ctl reboot
}

do_mods()
{
    runcmd rm -f "$(get_logs_dir)"/{mods.log,output.log,exitcode,run}
    run_on_target "$(get_target_mods_path)/mods" "$@"
}

do_gdbserver()
{
    [[ $1 = mods ]] && shift
    runcmd rm -f "$(get_logs_dir)"/{mods.log,output.log,exitcode,run}
    if [[ $_TEGRA_CONN = adb ]]; then
        set_adb_serial
        runcmd "$(get_adb)" forward tcp:5039 tcp:5039
        run_over_adb gdbserver tcp:5039 "$(get_target_mods_path)/mods" "$@"
    else
        die "Unsupported connection method '$_TEGRA_CONN' in conn property"
    fi
}

do_gdbclient()
{
    local TARGET=""
    local PORT=""

    [[ $(get_gdb) ]] || die "Missing client gdb, run `tegra buildgdb` to compile gdb"

    if [[ $_TEGRA_CONN = adb ]]; then
        TARGET="localhost"
        PORT="5039"
    else
        die "Unsupported connection method '$_TEGRA_CONN' in conn property"
    fi

    check_flash_target

    local RUNSPACE=$(get_mods_runspace)

    sed 's/^ *//' > "$(get_logs_dir)"/gdb.txt <<EOF
        set solib-search-path $(echo "$RUNSPACE" | escape_spaces)
        set sysroot $(get_nv_outdir | escape_spaces)/sysroot
        target remote $TARGET:$PORT
EOF
    while [[ $# -gt 0 ]]; do
        echo "$1" >> "$(get_logs_dir)"/gdb.txt
        shift
    done
    echo "continue" >> "$(get_logs_dir)"/gdb.txt

    if [[ $PRETEND ]]; then
        echo "% cat > $(get_logs_dir)/gdb.txt <<-EOF"
        sed 's/^/\t/' "$(get_logs_dir)"/gdb.txt
        echo "EOF"
    fi

    runcmd "$(get_gdb)" -x "$(get_logs_dir)"/gdb.txt "$RUNSPACE"/mods
}

do_buildgdb()
{
    [[ $# -eq 0 ]] || die "Unrecognized arguments: $@"
    [[ $(get_gdb) ]] && die "Client gdb is already available in $(get_gdb)"

    local VER="8.2"
    local SOURCE="https://ftp.gnu.org/gnu/gdb/gdb-$VER.tar.xz"
    runcmd mkdir -p "$(get_gdb_dir)"
    runcmd cd "$(get_gdb_dir)"
    echo "Downloading sources of gdb-$VER..."
    runcmd wget "$SOURCE"
    runcmd tar xJf "gdb-$VER.tar.xz"
    runcmd rm "gdb-$VER.tar.xz"
    runcmd cd "gdb-$VER"
    echo "Compiling gdb-$VER..."
    runcmd ./configure --target=aarch64-unknown-linux-gnu --with-expat --with-python --prefix="$(get_gdb_dir)"
    runcmd make -j "$(grep -c ^proc /proc/cpuinfo)"
    runcmd make -j "$(grep -c ^proc /proc/cpuinfo)" install
    [[ $(get_gdb) ]] || die "Client gdb compilation failed, gdb not found"
}

do_shell()
{
    [[ $# -gt 0 ]] || die "Missing command to run"

    run_on_target "$@"
}

tidy_up()
{
    # Kill any remaining background job
    kill %1 %2 2>/dev/null || true
}

trap tidy_up EXIT

main "$@"
